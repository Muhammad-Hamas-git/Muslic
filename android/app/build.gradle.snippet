// Merge these values into android/app/build.gradle (or build.gradle.kts)
// generated by `flutter create`. Only the lines below need changing.

android {
    namespace = "app.muslic"

    defaultConfig {
        applicationId = "app.muslic"
        minSdk = 23          // just_audio + media session baseline
        targetSdk = 34
        versionCode = 1
        versionName = "1.0.0"
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
}
